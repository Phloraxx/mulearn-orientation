NODE_ENV=production
PORT=3000
SITE_URL=https://orientation.mulearnscet.in
DATA_DIR=/data
DATABASE_PATH=/data/orientation.sqlite
CONTENT_DIR=/content

# Generate each independently: openssl rand -base64 36
SESSION_SECRET=replace-with-strong-random-value
HOST_BOOTSTRAP_SECRET=replace-with-strong-random-value
PROJECTOR_BOOTSTRAP_SECRET=replace-with-strong-random-value

# A strong prefix produces team links as: ${VOLUNTEER_TOKEN_PREFIX}-lion, etc.
VOLUNTEER_TOKEN_PREFIX=replace-with-strong-random-value

# Optional pre-event content generation only. Never needed by the live service.
OPENAI_API_KEY=
